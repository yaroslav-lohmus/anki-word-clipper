{
  "manifest_version": 3,
  "name": "Anki Word Clipper",
  "version": "0.6.3",
  "description": "Save Estonian words from websites to Anki with contextual Finnish translations via OpenRouter.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://openrouter.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://err.ee/*", "https://*.err.ee/*"],
      "js": ["context-extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-clipper-form": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Add selected text to Anki"
    }
  },
  "minimum_chrome_version": "102",
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
