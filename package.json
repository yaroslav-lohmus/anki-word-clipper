{
  "name": "anki-word-clipper",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test tests/*.test.js",
    "check": "pnpm lint && pnpm fmt:check && pnpm test",
    "eval": "node scripts/eval.mjs",
    "eval:offline": "node scripts/eval.mjs --offline",
    "eval:view": "node scripts/eval.mjs --view",
    "eval:summary": "node scripts/eval-summary.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "promptfoo": "0.125.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "10.32.1"
  },
  "packageManager": "pnpm@10.32.1"
}
